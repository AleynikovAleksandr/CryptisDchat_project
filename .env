# CryptisDchat — общие настройки всех контейнеров. Сгенерировано 2026-09-26 00:37.
# Секреты случайные; файл не коммитится (.gitignore).
#
# Локальный запуск: вход через dev-кошелёк (реальные TON-кошельки не подключаются к http://localhost).
# Для боевого сервера поменяйте 4 строки:
#   APP_ENV=production, DEV_WALLET_LOGIN=false,
#   PUBLIC_ORIGIN / ALLOWED_WS_ORIGINS = https://ваш-домен, TON_PROOF_DOMAIN = ваш-домен
APP_ENV=development
DEV_WALLET_LOGIN=true
PUBLIC_ORIGIN=http://85.95.150.8:3890
ALLOWED_WS_ORIGINS=http://85.95.150.8:3890,http://localhost:3890,http://127.0.0.1:3890
TON_PROOF_DOMAIN=85.95.150.8:3890
TON_NETWORK=-239

# --- MariaDB (сервис db) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=cryptisdchat
DB_USER=cryptis_user
DB_PASSWORD=IEv2oZ1yXDtEg3y9Sy5HXLZ-I-_f48Zy
DB_ROOT_PASSWORD=y3ToeBsyDIW00LNSy2-zPhe8gj_XwbQb

# --- Redis (сервис redis): 0 кэш, 1 брокер Celery, 2 результаты, 3 pub/sub ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- сессии (ТЗ 4.2) ---
JWT_SECRET=TnNv0JY9hLF6dTcwqIBN-svhQfaGFUONyJTh1O3G25S1Tp8SKjGCF7T-7sicUggE
TON_PROOF_SECRET=VfRFCCoQMTBXryJehZNeNkTSpcWrNqqaEhhnNQWTos-p_9X24pxnNHTag3VkcMrQ
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- блокчейн: батчи Меркла (режим сети TON задаётся в worker.env) ---
BLOCKCHAIN_MODE=mock
CHAIN_BATCH_INTERVAL_SECONDS=120
CHAIN_BATCH_MAX_ITEMS=500

# --- резервное копирование ключей ---
REALM_URLS=http://realm1:9000,http://realm2:9000,http://realm3:9000

# --- файлы и лимиты ---
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_DEFAULT=120/60
RATE_LIMIT_AUTH=20/60

